    <string name="ways_title">Ways to use it</string>
    <string name="way_share_title">Share menu</string>
    <string name="way_share_body">In X, Spotify, Instagram, Temu or any app, tap Share and choose “Clean link”. The clean link is copied, and the share menu opens again so you can send it on.</string>
    <string name="way_select_title">Text selection</string>
    <string name="way_select_body">Select a link and pick “Clean link” from the menu. In a text box, the link is replaced in place.</string>
    <string name="way_tile_title">Quick Settings tile</string>
    <string name="way_tile_body">Copy a link, then tap the tile: the clean link replaces it on your clipboard.</string>
    <string name="add_tile">Add tile</string>

    <string name="settings_title">Settings</string>
    <string name="setting_expand_title">Expand short links</string>
    <string name="setting_expand_body">Follow t.co, temu.to, vm.tiktok.com and similar links to clean the real address. This contacts the short link\'s server; no cookies are sent.</string>
    <string name="setting_copy_title">Only copy</string>
    <string name="setting_copy_body">When you share to BorraLoco, just copy the clean link without reopening the share menu.</string>
    <string name="setting_intercept_title">Clean every link I open</string>
    <string name="setting_intercept_body">BorraLoco appears as a browser. Make it your default browser and each tapped link is cleaned, then opened in your real browser or app.</string>
    <string name="open_default_apps">Choose default browser</string>

    <string name="supported_title">Supported platforms</string>
    <string name="supported_note">Plus utm_*, fbclid, gclid and other common trackers on every website.</string>

